# Application Mode: 'demo' or 'aws'
# In 'demo' mode, local extractive summarization and local file storage are used.
# In 'aws' mode, AWS S3 and Amazon SageMaker AI inference endpoint are used.
APP_MODE=demo

# Server Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Document Constraints
MAX_FILE_SIZE_MB=10
MAX_EXTRACTED_TEXT_CHARS=50000

# AWS Configuration (Required only when APP_MODE=aws)
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-private-documind-summaries-bucket
SAGEMAKER_ENDPOINT_NAME=documind-summarizer-endpoint

# SageMaker Model Format Configuration:
# - 'huggingface': Default for HF summarization models (e.g., facebook/bart-large-cnn)
# - 'jumpstart': JumpStart LLM prompt-response format
# - 'custom_json': Generic {"text": "...", "parameters": {...}}
SAGEMAKER_PAYLOAD_FORMAT=huggingface

# AWS Credentials:
# For production or EC2/ECS/SageMaker instances, use IAM roles.
# For local development with AWS, set your credentials here or use `aws configure` ~/.aws/credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
